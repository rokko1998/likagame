{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likagame.local/schemas/content-bundle.schema.json",
  "title": "ContentBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "content_version",
    "engine_compatibility",
    "bundle_hash",
    "themes",
    "scenes",
    "encounters",
    "adventure_blocks",
    "adventure_recipes",
    "dialogue_catalog",
    "asset_manifests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_id": { "type": "string", "minLength": 1 },
    "content_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engine_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max_exclusive"],
      "properties": {
        "min": { "type": "string" },
        "max_exclusive": { "type": "string" }
      }
    },
    "bundle_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": { "id": { "type": "string" }, "title": { "type": "string" } }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "asset_ids"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "asset_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "encounters": { "type": "array", "minItems": 1, "items": { "$ref": "encounter-definition.schema.json" } },
    "adventure_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "block_kind", "encounter_ref", "scene_ref"],
        "properties": {
          "id": { "type": "string" },
          "block_kind": { "enum": ["story", "encounter", "input_smoke", "epilogue"] },
          "encounter_ref": { "type": ["string", "null"] },
          "scene_ref": { "type": "string" }
        }
      }
    },
    "adventure_recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required_block_refs"],
        "properties": {
          "id": { "type": "string" },
          "required_block_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "dialogue_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "text", "audio_file", "intent"],
        "properties": {
          "id": { "type": "string" },
          "speaker": { "enum": ["pik", "nima", "system"] },
          "text": { "type": "string", "minLength": 1 },
          "audio_file": { "type": "string", "pattern": "^/assets/voice/[a-z0-9-]+\\.mp3$" },
          "intent": { "type": "string" }
        }
      }
    },
    "asset_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "license", "source_url", "files"],
        "properties": {
          "id": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https://" },
          "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
